# Copy this file onto the server as `.env` next to docker-compose.yml:
#   cp deploy/env.production.example .env
# Replace every CHANGE_ME. Do not commit the filled file.
#
# Do not retrain CIR. Restore the existing Postgres dump instead.

# -----------------------------------------------------------------------------
# Public origins (what a user's browser will open)
# -----------------------------------------------------------------------------
# Website:
#   https://ace.gg
# API the browser calls for search + compare typeahead:
#   https://api.ace.gg
#
# First VPS without TLS:
#   PUBLIC_WEB_ORIGIN=http://YOUR.SERVER.IP:3000
#   NEXT_PUBLIC_API_URL=http://YOUR.SERVER.IP:8000
#   CORS_ORIGINS=http://YOUR.SERVER.IP:3000

PUBLIC_WEB_ORIGIN=https://CHANGE_ME.example
NEXT_PUBLIC_API_URL=https://api.CHANGE_ME.example
CORS_ORIGINS=https://CHANGE_ME.example

# -----------------------------------------------------------------------------
# Postgres (compose service name is `db`)
# POSTGRES_PASSWORD and the password inside DATABASE_URL must match.
# URL-encode special characters in DATABASE_URL (@ : / # ? become %40 %3A etc).
# -----------------------------------------------------------------------------
POSTGRES_USER=valorant
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=valorant_scout
POSTGRES_PORT=5432
DATABASE_URL=postgresql://valorant:CHANGE_ME_STRONG_PASSWORD@db:5432/valorant_scout

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
DOCS_ENABLED=false
# Per connecting IP. Compare is heavier; keep it lower.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_COMPARE_PER_MINUTE=60

# Web server-side fetch uses the compose DNS name. Do not point this at localhost.
# docker-compose.yml already sets API_URL=http://api:8000 for the web container.

# -----------------------------------------------------------------------------
# Daily ingest — scrape new VCT maps, then refresh frozen CIR snapshots.
# Does not retrain CIR. Needs a reachable vlrggapi (axsddlr/vlrggapi).
#
# Railway: set these on the API service, then either
#   VCT_SYNC_ENABLED=true  (in-process 03:00 UTC) and/or
#   GitHub Action POST /ops/vct-sync with VCT_SYNC_TOKEN
# Compose alternative: docker compose --profile sync up -d vct-sync
# -----------------------------------------------------------------------------
# VLRGGAPI_BASE_URL=http://host.docker.internal:3002
# VCT_SYNC_SEASON_YEAR=2026
# VCT_SYNC_CRON=0 3 * * *
# VCT_SYNC_ENABLED=false
# VCT_SYNC_TOKEN=CHANGE_ME_LONG_RANDOM
